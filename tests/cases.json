{
  "version": 1,
  "default": [
    "unit"
  ],
  "defaults": {},
  "cases": [
    {
      "name": "docs",
      "suite": "unit",
      "command": [
        "{python}",
        "tests/docs_checks.py",
        "--nvim",
        "{nvim}"
      ],
      "files": [
        "tests/docs_checks.py"
      ],
      "timeout": 60
    },
    {
      "name": "runner-contracts",
      "suite": "unit",
      "command": [
        "{python}",
        "tests/runner_checks.py"
      ],
      "files": [
        "tests/runner_checks.py"
      ],
      "timeout": 120
    },
    {
      "name": "lazy",
      "suite": "unit",
      "command": [
        "{nvim}",
        "--clean",
        "--headless",
        "-i",
        "NONE",
        "-l",
        "tests/lazy.lua"
      ],
      "files": [
        "tests/lazy.lua"
      ],
      "timeout": 90
    },
    {
      "name": "key_ownership",
      "suite": "unit",
      "command": [
        "{nvim}",
        "--clean",
        "--headless",
        "-i",
        "NONE",
        "-l",
        "tests/key_ownership.lua"
      ],
      "files": [
        "tests/key_ownership.lua"
      ],
      "timeout": 90
    },
    {
      "name": "setup_contract",
      "suite": "unit",
      "command": [
        "{nvim}",
        "--clean",
        "--headless",
        "-i",
        "NONE",
        "-l",
        "tests/setup_contract.lua"
      ],
      "files": [
        "tests/setup_contract.lua"
      ],
      "timeout": 90
    },
    {
      "name": "command_ownership",
      "suite": "unit",
      "command": [
        "{nvim}",
        "--clean",
        "--headless",
        "-i",
        "NONE",
        "-l",
        "tests/command_ownership.lua"
      ],
      "files": [
        "tests/command_ownership.lua"
      ],
      "timeout": 90
    },
    {
      "name": "run",
      "suite": "unit",
      "command": [
        "{nvim}",
        "--clean",
        "--headless",
        "-i",
        "NONE",
        "-l",
        "tests/run.lua"
      ],
      "files": [
        "tests/run.lua"
      ],
      "requires": [
        "env:TEX_TOOLS_TEST_PARSER",
        "path:$TEX_TOOLS_TEST_PARSER"
      ],
      "timeout": 300
    },
    {
      "name": "live_texquill",
      "suite": "acceptance",
      "command": [
        "{nvim}",
        "--clean",
        "--headless",
        "-i",
        "NONE",
        "-l",
        "tests/live_texquill.lua"
      ],
      "files": [
        "tests/live_texquill.lua"
      ],
      "requires": [
        "exe:texquill",
        "exe:latexmk"
      ],
      "timeout": 180
    },
    {
      "name": "live_latexmk",
      "suite": "acceptance",
      "command": [
        "{nvim}",
        "--clean",
        "--headless",
        "-i",
        "NONE",
        "-l",
        "tests/live_latexmk.lua"
      ],
      "files": [
        "tests/live_latexmk.lua"
      ],
      "requires": [
        "exe:texquill",
        "exe:latexmk"
      ],
      "timeout": 180
    }
  ],
